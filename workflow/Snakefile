### Imports ###
from os.path import join
from pandas import read_table

### Config file ###
configfile: join('config', 'config.yaml')

### Setup ###
global_resources = workflow.global_resources

if 'gpus' in global_resources and global_resources['gpus'].value > 0:
    from lib.gpu_manager import GpuManager

    assert global_resources['gpus'] == len(config['gpu_ids']), (
            'The number of GPUs in resources must match '
            'the length of provided GPU IDs')

    gpu_manager = GpuManager(config['gpu_ids'])

    USE_GPU = True
else:
    USE_GPU = False

### Input and output variables ###
include: join('rules', 'variables.smk')

### Targets ###
def get_network_targets(wc):
    with checkpoints.select_best_slides.get().output['mapping'].open() as f:
        df = read_table(f)
        return expand(
            expand(
                SPOT_INDEGREES_ALT,
                zip,
                patient_id=df['patient_id'],
                slide=df[config['slide_selection']],
            ),
            min_counts=config['min_counts_per_spot'],
        )

