def get_fn_collated_agg_expression_target(wc):
    return expand(
        FN_COLLATED_CLUSTERED_AGG_EXPRESSION,
        min_counts=config['min_counts_per_spot'],
        resolution=config['clustering_resolutions'],
        ratio_threshold=config['filter_ratio_threshold'],
    )

def get_region_network_targets(wc):
    return expand(
        REGION_INDEGREES,
        min_counts=config['min_counts_per_spot'],
        resolution=config['clustering_resolutions'],
        ratio_threshold=config['filter_ratio_threshold'],
    )

