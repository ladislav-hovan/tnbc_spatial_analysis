### Config file ###
configfile: join('config', 'config.yaml')

### Setup ###
global_resources = workflow.global_resources

if 'gpus' in global_resources and global_resources['gpus'].value > 0:
    from lib.gpu_manager import GpuManager

    assert global_resources['gpus'] == len(config['gpu_ids']), (
            'The number of GPUs in resources must match '
            'the length of provided GPU IDs')

    gpu_manager = GpuManager(config['gpu_ids'])

    USE_GPU = True
else:
    USE_GPU = False

### Input and output variables ###
include: join('rules', 'variables.smk')

### Targets ###
# The order is: combination to be used for pairing, column, groupA, groupB
# If you want to constrain a different column to a value (subset the samples),
# you can specify the column as 'column1=value__column2'
LIMMA_COMBINATIONS = [
    join('{0}', '{1}', '{2}_{3}').format(*combs) for combs in
    [
        ['Patient+Slide', 'Classification', 'Stroma', 'Tumor'],
    ]
]

def get_annotated_region_limma_gsea_results(wc):
    return expand(
        join('<results>', 'limma', 'min_{min_counts}_counts',
            'ratio_threshold_{ratio_threshold}', '{combination}',
            '{modality}', 'gsea', '{geneset_name}', 'dotplot.png'),
        min_counts=config['min_counts_per_spot'],
        ratio_threshold=config['filter_ratio_threshold'],
        combination=LIMMA_COMBINATIONS,
        modality=config['gsea_modalities'],
        geneset_name=config['gene_sets'],
    )

### Rules ###
rule all:
    input:
        get_annotated_region_limma_gsea_results,
    default_target:
        True

include: join('rules', 'preprocessing.smk')
include: join('rules', 'networks.smk')
include: join('rules', 'limma.smk')